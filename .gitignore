# Publish only the finished portfolio. Experiments and offline tooling stay local.
/*
!/.gitignore
!/.nojekyll
!/CNAME
!/DEPLOYMENT.md
!/index.html
!/style.css
!/favicon.svg
!/paper-texture.png
!/frame.js
!/study-player.mjs
!/liquid.mjs
!/bubble.mjs
!/palantir/
!/resume/
!/vendor/
/vendor/*
!/vendor/hyalite.js
!/vendor/LICENSE
!/projects/
/projects/*
!/projects/items.json
!/projects/gallery.json
!/projects/*/
/projects/*/*
!/projects/*/*.png
!/projects/*/*.jpg
!/projects/*/*.jpeg
!/projects/*/*.webp
!/projects/*/*.mp4
!/projects/*/*.webm
!/projects/*/captions.json
!/studies/
/studies/*
!/studies/assets/
/studies/assets/*
!/studies/assets/manifest.json
!/studies/assets/*.png
!/studies/assets/*.webp
!/studies/assets/*.webm
